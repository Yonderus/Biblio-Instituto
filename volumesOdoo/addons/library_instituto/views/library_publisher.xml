<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Vista listado de editoriales -->
	<record id="view_library_publisher_list" model="ir.ui.view">
		<field name="name">library.publisher.list</field>
		<field name="model">library.publisher</field>
		<field name="arch" type="xml">
			<list>
				<field name="name"/>
				<field name="ciudad"/>
				<field name="email"/>
				<field name="telefono"/>
			</list>
		</field>
	</record>

	<!-- Vista formulario de editoriales -->
	<record id="view_library_publisher_form" model="ir.ui.view">
		<field name="name">library.publisher.form</field>
		<field name="model">library.publisher</field>
		<field name="arch" type="xml">
			<form string="Editorial">
				<sheet>
					<group>
						<group>
							<field name="name"/>
							<field name="ciudad"/>
						</group>
						<group>
							<field name="email"/>
							<field name="telefono"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<!-- Acción para editoriales -->
	<record id="action_library_publisher" model="ir.actions.act_window">
		<field name="name">Editoriales</field>
		<field name="res_model">library.publisher</field>
		<field name="view_mode">list,form</field>
	</record>
</odoo>