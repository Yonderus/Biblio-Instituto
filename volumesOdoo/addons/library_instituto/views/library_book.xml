<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<!-- Vista listado de libros -->
	<record id="view_library_book_list" model="ir.ui.view">
		<field name="name">library.book.list</field>
		<field name="model">library.book</field>
		<field name="arch" type="xml">
			<list>
				<field name="title"/>
				<field name="isbn"/>
				<field name="author_id"/>
				<field name="publisher_id"/>
				<field name="edition_year"/>
				<field name="total_copies"/>
				<field name="genre"/>
				<field name="state"/>
			</list>
		</field>
	</record>

	<!-- Vista formulario de libros -->
	<record id="view_library_book_form" model="ir.ui.view">
		<field name="name">library.book.form</field>
		<field name="model">library.book</field>
		<field name="arch" type="xml">
			<form string="Libro">
				<sheet>
					<group>
						<group>
							<field name="title"/>
							<field name="isbn"/>
							<field name="author_id"/>
							<field name="publisher_id"/>
						</group>
						<group>
							<field name="edition_year"/>
							<field name="total_copies"/>
							<field name="genre"/>
							<field name="state"/>
						</group>
					</group>
					<group>
						<field name="cover_image" widget="image" class="oe_avatar"/>
					</group>
				</sheet>
			</form>
		</field>
	</record>

	<!-- Acción para libros -->
	<record id="action_library_book" model="ir.actions.act_window">
		<field name="name">Libros</field>
		<field name="res_model">library.book</field>
		<field name="view_mode">list,form</field>
	</record>

	<!-- Menú de libros debajo del menú principal -->
	<menuitem id="menu_library_book" name="Libros" parent="menu_library_root" action="action_library_book" sequence="10"/>
</odoo>
