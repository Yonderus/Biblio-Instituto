<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Herencia del formulario de contactos para campos de biblioteca -->
  <record id="view_partner_form_library_inherit" model="ir.ui.view">
    <field name="name">res.partner.form.library.inherit</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet/notebook" position="inside">
        <page string="Biblioteca">
          <group>
            <group>
              <field name="library_user_type"/>
              <field name="library_course_group" invisible="library_user_type != 'alumno'"/>
              <field name="library_card_number"/>
              <field name="library_max_loans"/>
              <field name="library_active_loans" readonly="1"/>
              <field name="total_late_days" readonly="1"/>
            </group>
          </group>
          <group string="Prestamos">
            <field name="library_loan_ids" readonly="1">
              <list>
                <field name="book_id"/>
                <field name="state"/>
                <field name="loan_date"/>
                <field name="expected_return_date"/>
                <field name="real_return_date"/>
              </list>
            </field>
          </group>
        </page>
      </xpath>
    </field>
  </record>

  <!--
  VISTA KANBAN: Tarjetas de usuarios de la biblioteca

  Muestra cada usuario como una tarjeta con:
  - Foto de perfil (image_128: versión reducida del avatar de res.partner)
  - Nombre
  - Badge con el tipo de usuario (alumno / docente / administración)
  - Número de carnet
  - Préstamos activos en este momento
  -->
  <record id="view_library_users_kanban" model="ir.ui.view">
    <field name="name">res.partner.library.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <kanban class="o_kanban_small_column">
        <!-- Campos que necesita la plantilla para renderizar cada tarjeta -->
        <field name="name"/>
        <field name="image_128"/>
        <field name="library_user_type"/>
        <field name="library_card_number"/>
        <field name="library_active_loans"/>

        <templates>
          <t t-name="kanban-box">
            <div class="oe_kanban_global_click o_kanban_record d-flex flex-column align-items-center p-3" style="min-width:160px;">

              <!-- FOTO DE PERFIL
                   URL construida con + (JavaScript) en vez de % (Python).
                   Si el usuario no tiene foto, Odoo devuelve su avatar por defecto. -->
              <div class="mb-2">
                <img t-att-src="'/web/image/res.partner/' + record.id.raw_value + '/image_128'"
                     style="width:80px;height:80px;border-radius:50%;object-fit:cover;"
                     alt="Foto"/>
              </div>

              <!-- NOMBRE -->
              <strong class="text-center"><field name="name"/></strong>

              <!-- BADGE TIPO DE USUARIO -->
              <!-- t-if/t-elif/t-else: muestra un span distinto según el tipo,
                   cada uno con su clase de color de Bootstrap -->
              <div class="mt-1">
                <t t-if="record.library_user_type.raw_value == 'alumno'">
                  <span class="badge text-bg-primary"><field name="library_user_type"/></span>
                </t>
                <t t-elif="record.library_user_type.raw_value == 'docente'">
                  <span class="badge text-bg-success"><field name="library_user_type"/></span>
                </t>
                <t t-else="">
                  <span class="badge text-bg-secondary"><field name="library_user_type"/></span>
                </t>
              </div>

              <!-- CARNET Y PRÉSTAMOS -->
              <div class="mt-2 text-muted small text-center">
                <div>Carnet: <field name="library_card_number"/></div>
                <div>Préstamos activos: <field name="library_active_loans"/></div>
              </div>

            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <!-- Vista lista de usuarios biblioteca con columnas de biblioteca -->
  <record id="view_library_users_list" model="ir.ui.view">
    <field name="name">res.partner.library.list</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="library_user_type"/>
        <field name="library_card_number"/>
        <field name="library_max_loans"/>
        <field name="library_active_loans"/>
        <field name="total_late_days"/>
      </list>
    </field>
  </record>

  <!-- Accion de usuarios biblioteca — kanban como vista por defecto -->
  <!-- view_ids fuerza que se use nuestro kanban personalizado en vez del kanban
       por defecto de res.partner que trae Odoo. Sin esto Odoo ignora nuestra vista. -->
  <record id="action_library_users" model="ir.actions.act_window">
    <field name="name">Usuarios biblioteca</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[("library_card_number", "!=", False)]</field>
    <field name="context">{"default_company_type": "person"}</field>
    <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'kanban', 'view_id': ref('view_library_users_kanban')}), (0, 0, {'view_mode': 'list', 'view_id': ref('view_library_users_list')})]"/>
  </record>
</odoo>
