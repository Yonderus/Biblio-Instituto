<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista listado de autores -->
  <record id="view_library_author_list" model="ir.ui.view">
    <field name="name">library.author.list</field>
    <field name="model">library.author</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="pais"/>
        <field name="fecha_nacimiento"/>
      </list>
    </field>
  </record>

  <!-- Acción para autores -->
  <record id="action_library_author" model="ir.actions.act_window">
    <field name="name">Autores</field>
    <field name="res_model">library.author</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menú raíz para la app -->
  <menuitem id="menu_library_root" name="Library Instituto" sequence="25"/>

  <!-- Menú contenedor para agrupar opciones en desplegable -->
  <menuitem id="menu_library_catalog" name="Biblioteca" parent="menu_library_root" sequence="10"/>

  <!-- Submenú de autores -->
  <menuitem id="menu_library_author" name="Autores" parent="menu_library_catalog" action="action_library_author" sequence="20"/>
</odoo>
