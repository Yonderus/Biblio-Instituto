<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista listado de autores -->
  <record id="view_library_author_list" model="ir.ui.view">
    <field name="name">library.author.list</field>
    <field name="model">library.author</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="pais"/>
        <field name="fecha_nacimiento"/>
      </list>
    </field>
  </record>

  <!-- Acción para autores -->
  <record id="action_library_author" model="ir.actions.act_window">
    <field name="name">Library Instituto</field>
    <field name="res_model">library.author</field>
    <field name="view_mode">list,form</field>
  </record>

  <!-- Menú raíz con acción directa para que aparezca en el lanzador de apps -->
  <menuitem id="menu_library_root" name="Library Instituto" action="action_library_author" sequence="25"/>
</odoo>
