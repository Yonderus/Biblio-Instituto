<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista listado de autores -->
  <record id="view_library_author_list" model="ir.ui.view">
    <field name="name">library.author.list</field>
    <field name="model">library.author</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="pais"/>
        <field name="fecha_nacimiento"/>
      </list>
    </field>
  </record>

  <!-- Vista formulario de autores -->
  <record id="view_library_author_form" model="ir.ui.view">
    <field name="name">library.author.form</field>
    <field name="model">library.author</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="name"/>
            <field name="pais"/>
            <field name="fecha_nacimiento"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción para la vista de autores -->
  <record id="action_library_author" model="ir.actions.act_window">
    <field name="name">Autores</field>
    <field name="res_model">library.author</field>
    <field name="view_mode">list,form</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        Crea tu primer autor de libros.
      </p>
    </field>
  </record>

  <!-- Menú para autores (raíz) -->
  <menuitem id="menu_library_author" name="Autores" action="action_library_author" sequence="100"/>
</odoo>
