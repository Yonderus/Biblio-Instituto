<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Vista listado de autores -->
  <record id="view_library_author_list" model="ir.ui.view">
    <field name="name">library.author.list</field>
    <field name="model">library.author</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="country_id"/>
        <field name="birth_date"/>
      </list>
    </field>
  </record>

  <!--
  VISTA FORMULARIO: Detalle de un autor

  Se abre al hacer click en un autor desde la lista.
  Muestra nombre, país, fecha de nacimiento y los libros
  vinculados a ese autor (Many2many inversa).

  widget="many2many_tags": muestra los libros como etiquetas clickeables
  en vez de una tabla completa, más limpio para una relación inversa.
  -->
  <record id="view_library_author_form" model="ir.ui.view">
    <field name="name">library.author.form</field>
    <field name="model">library.author</field>
    <field name="arch" type="xml">
      <form string="Autor">
        <sheet>
          <group>
            <field name="name"/>
            <field name="country_id"/>
            <field name="birth_date"/>
          </group>
          <group string="Libros del autor">
            <field name="book_ids" widget="many2many_tags" nolabel="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Acción para autores -->
  <record id="action_library_author" model="ir.actions.act_window">
    <field name="name">Autores</field>
    <field name="res_model">library.author</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
